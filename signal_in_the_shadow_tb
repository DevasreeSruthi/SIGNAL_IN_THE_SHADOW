`timescale 1ns/1ps

module signal_in_the_shadow_tb;

    logic clk;
    logic rst_n;

    logic [7:0] radar_sample;
    logic [7:0] background_level;
    logic [7:0] base_threshold;
    logic [2:0] required_persistence;

    logic valid_in;

    logic target_detected;
    logic [7:0] signal_magnitude;
    logic [7:0] estimated_noise;
    logic [7:0] adaptive_threshold;
    logic [7:0] confidence;
    logic valid_out;

    integer failures;
    integer detections_in_background;
    integer detections_during_spike;
    integer detections_during_target;

    always #5 clk = ~clk;
    signal_in_the_shadow_top dut (
        .clk(clk),
        .rst_n(rst_n),
        .radar_sample(radar_sample),
        .background_level(background_level),
        .base_threshold(base_threshold),
        .required_persistence(required_persistence),
        .valid_in(valid_in),
        .target_detected(target_detected),
        .signal_magnitude(signal_magnitude),
        .estimated_noise(estimated_noise),
        .adaptive_threshold(adaptive_threshold),
        .confidence(confidence),
        .valid_out(valid_out)
    );

task automatic send_sample(input logic [7:0] value);
    begin
        @(negedge clk);
        radar_sample = value;
        valid_in = 1'b1;

        @(posedge clk);
    end
endtask
    task automatic check_no_detection(input integer cycles);
        integer i;
        begin
            for (i = 0; i < cycles; i = i + 1) begin
                @(negedge clk);
                if (target_detected === 1'b1)
                    failures = failures + 1;
            end
        end
    endtask

    initial begin
        $dumpfile("build/signal_in_the_shadow.vcd");
        $dumpvars(0, signal_in_the_shadow_tb);

        clk = 1'b0;
        rst_n = 1'b0;

        radar_sample = 8'd0;
        background_level = 8'd20;
        base_threshold = 8'd10;
        required_persistence = 3'd3;
        valid_in = 1'b0;

        failures = 0;
        detections_in_background = 0;
        detections_during_spike = 0;
        detections_during_target = 0;

        repeat (2) @(negedge clk);
        rst_n = 1'b1;

        $display("");
        $display("==============================================");
        $display("         SIGNAL IN THE SHADOW");
        $display("         AUTOMATED RTL TESTS");
        $display("==============================================");

        // TEST 1: NORMAL BACKGROUND
        $display("");
        $display("TEST 1: NORMAL BACKGROUND");

        send_sample(8'd20);
        send_sample(8'd21);
        send_sample(8'd20);
        send_sample(8'd19);
        send_sample(8'd21);
        send_sample(8'd20);
        repeat (4) @(negedge clk);

        if (target_detected === 1'b0) begin
            $display("PASS: No target detected after background samples.");
        end else begin
            $display("FAIL: Unexpected detection after background samples.");
            failures = failures + 1;
        end

        // TEST 2: ISOLATED INTERFERENCE
        $display("");
        $display("TEST 2: ISOLATED INTERFERENCE");

        send_sample(8'd20);
        send_sample(8'd55);
        send_sample(8'd20);
        send_sample(8'd21);
        send_sample(8'd20);

        repeat (6) @(negedge clk);

        if (target_detected === 1'b0) begin
            $display("PASS: Isolated spike did not produce a lasting detection.");
        end else begin
            $display("FAIL: Detection remained asserted after the isolated spike.");
            failures = failures + 1;
        end

        // TEST 3: PERSISTENT ELEVATED SIGNAL
        $display("");
        $display("TEST 3: PERSISTENT ELEVATED SIGNAL");

        send_sample(8'd20);
        send_sample(8'd34);
        send_sample(8'd35);
        send_sample(8'd36);
        send_sample(8'd35);
        send_sample(8'd37);
        send_sample(8'd36);

        repeat (4) @(negedge clk);

        if (target_detected === 1'b1) begin
            $display("PASS: Persistent elevated signal triggered detection.");
        end else begin
            $display("FAIL: Persistent elevated signal was not detected.");
            failures = failures + 1;
        end

        // TEST 4: RETURN TO BACKGROUND
        $display("");
        $display("TEST 4: RETURN TO BACKGROUND");

        send_sample(8'd20);
        send_sample(8'd20);
        send_sample(8'd20);
        send_sample(8'd20);

        repeat (6) @(negedge clk);

        if (target_detected === 1'b0) begin
            $display("PASS: Detection cleared after return to background.");
        end else begin
            $display("FAIL: Detection did not clear as expected.");
            failures = failures + 1;
        end

        // FINAL SUMMARY
        $display("");
        $display("==============================================");

        if (failures == 0)
            $display("RESULT: ALL AUTOMATED CHECKS PASSED");
        else
            $display("RESULT: %0d CHECK(S) FAILED", failures);

        $display("==============================================");

        $finish;
    end

    always @(negedge clk) begin
        if (rst_n) begin
            $display(
                "IN=%3d VALID=%b NOISE=%3d THRESH=%3d MAG=%3d DETECT=%b CONF=%3d",
                radar_sample,
                valid_in,
                estimated_noise,
                adaptive_threshold,
                signal_magnitude,
                target_detected,
                confidence
            );
        end
    end

endmodule
